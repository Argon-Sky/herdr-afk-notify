# ntfy topic to publish to. On the public ntfy.sh server the topic name is the only secret: anyone who knows it can subscribe and publish. Use a long, unguessable name, or self-host and use a token.
NTFY_TOPIC=

# Optional. Defaults to https://ntfy.sh.
NTFY_SERVER=https://ntfy.sh

# Optional. Bearer token for a server with access control.
NTFY_TOKEN=

# A finished turn notifies only when the agent worked at least this long. Blocked always notifies.
AFK_MIN_WORKING_SECONDS=300

# Notify only once the Mac has had no keyboard or mouse input for this long. 0 notifies at once.
AFK_AWAY_SECONDS=180
